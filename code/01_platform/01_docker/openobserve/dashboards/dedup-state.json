{
  "version": 8,
  "title": "Dedup State (DEC-038)",
  "description": "Fluss dedup-table state, Flink cache hit ratio, cleanup and rehydration - proves large state lives in Fluss (2026-08-22 single-pane). Cardinality: queries aggregate over global+slot series only (no per-token group-by; log tails bounded by LIMIT). Per-token metric series are limited to the top-20 sampler in otel-collector-config.yaml (METRICS_TOP20_TOKENS_REGEX); tick logs arrive 1% sampled with errors/gaps 100% — see docs/08_implementation/10-observability.md.",
  "folder_id": "default",
  "tabs": [
    {
      "tabId": "default",
      "name": "Dedup",
      "panels": [
        {
          "id": "1",
          "type": "line",
          "title": "Fluss dedup-table entries (fingerprint_dedup)",
          "description": "Per-table gauge - entry count; bounded cardinality. Source: Flink dedup state size metric via OTLP.",
          "config": {
            "show_legends": true,
            "legends_position": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x, avg(dedup_state_entries) AS y FROM \"metrics\" WHERE metric_name='flink_taskmanager_job_task_operator_compute_dedup_state_count' GROUP BY x",
              "customQuery": true,
              "fields": {
                "stream": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                },
                "stream_type": "metrics"
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 64,
            "h": 8,
            "i": 1
