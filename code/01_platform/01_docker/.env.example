# Copy this file to .env and fill in real values. NEVER commit .env.
# `make env` does this copy for you.

# ---- Fluss / Flink image tags (pin before first run) ----
FLUSS_IMAGE=fluss/fluss:0.8.0
FLINK_IMAGE=flink:1.20
OPENALGO_IMAGE=openalgo/openalgo:latest
OPENOBSERVE_IMAGE=openobserve/openobserve:latest

# ---- Fluss cluster (lake tiering needs S3) ----
FLUSS_BOOTSTRAP=fluss-coordinator:9123
# datalake.* cluster-level defaults (must match DDL table.datalake.format)
DATALAKE_FORMAT=iceberg
# AWS S3 (Iceberg lake) — use instance role or creds below
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=trading-lake
S3_WAREHOUSE_PATH=s3://trading-lake/warehouse

# ---- Zerodha Kite (market data + postback) ----
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_WS_URL=wss://ws.kite.trade
KITE_POSTBACK_URL=  # your public postback endpoint, or use the fill-capture WS

# ---- OpenAlgo (dumb executor) ----
OPENALGO_BASE_URL=http://openalgo:5000
OPENALGO_API_KEY=

# ---- OpenObserve ----
O2_USER=admin@example.com
O2_PASSWORD=
