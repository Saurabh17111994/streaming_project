<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" shutdownHook="disable">
  <!--
    Log4j2 configuration for the trading platform ingestion service.

    Two appenders:
      1. Console — human-readable, always on stderr (for startup debugging)
      2. File   — JSON structured log matching OpenObserve contract, rolling daily + 64 MB

    SLF4J bridge: log4j-slf4j-impl 2.25.4 → Log4j2 2.25.4
    Same version the Fluss server uses.
  -->

  <Properties>
    <!-- R-171: LOG_DIR defaults to an absolute container path (a relative
         'logs' landed in the ephemeral /app writable layer and was lost on
         container recreate). Launchers override via -Dlog.dir or LOG_DIR. -->
    <Property name="LOG_DIR">${sys:log.dir:-${env:LOG_DIR:-/data/ingestion/logs}}</Property>
    <Property name="HOST">${env:HOSTNAME:-${env:COMPUTERNAME:-unknown}}</Property>
    <Property name="ENV">${env:DEPLOY_ENV:-dev}</Property>
    <Property name="VM_ID">${env:VM_ID:-vm0}</Property>

    <!-- R-119: render the MDC correlation_id exactly ONCE (the old pattern
         emitted it three times with no separator). -->
    <Property name="CONSOLE_PATTERN">%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} %equals{[%X{correlation_id}]}{[]}{}%ex{short} - %msg%n</Property>
  </Properties>

  <Appenders>
    <!-- ================================================================ -->
    <!-- Console — human-readable, always active, prints startup errors    -->
    <!-- ================================================================ -->
    <Console name="CONSOLE" target="SYSTEM_ERR">
      <PatternLayout pattern="${CONSOLE_PATTERN}"/>
    </Console>

    <!-- ================================================================ -->
    <!-- File — JSON structured log, rolling daily + size-based           -->
    <!-- Matches the OpenObserve contract: docs/04_contracts/openobserve.md -->
    <!-- ================================================================ -->
    <RollingFile name="JSON_FILE"
                 fileName="${LOG_DIR}/ingestion.json"
                 filePattern="${LOG_DIR}/ingestion-%d{yyyy-MM-dd}-%i.json.gz"
                 immediateFlush="true">
      <JsonLayout compact="true" eventEol="true" properties="true"
                  includeStacktrace="true" stacktraceAsString="true">
        <!-- R-161: JsonLayout properties=true serializes only the ThreadContext
             (MDC) map — configuration <Property> values are NOT emitted.
             KeyValuePair adds the operator-visible host/env/vm_id fields. -->
        <KeyValuePair key="host" value="${HOST}"/>
        <KeyValuePair key="env" value="${ENV}"/>
        <KeyValuePair key="vm_id" value="${VM_ID}"/>
      </JsonLayout>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="64 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="30">
        <Delete basePath="${LOG_DIR}" maxDepth="1">
          <IfFileName glob="ingestion-*.json.gz"/>
          <IfLastModified age="30d"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- Fluss internals are noisy; keep at WARN unless debugging -->
    <Logger name="org.apache.fluss" level="WARN"/>
    <Logger name="org.apache.fluss.client" level="INFO"/>

    <!-- Shaded Netty from Fluss — very noisy at INFO -->
    <Logger name="org.apache.fluss.shaded.netty4" level="WARN"/>

    <!-- Application loggers -->
    <Logger name="com.trading" level="INFO"/>

    <Root level="INFO">
      <AppenderRef ref="CONSOLE"/>
      <AppenderRef ref="JSON_FILE"/>
    </Root>
  </Loggers>
</Configuration>
