#!/usr/bin/env bash
# Post-soak SAFETY-INT-001 runner (2026-08-09).
# Waits for the seven-hour soak to finish (3 recoveries in recoveries.txt AND
# run.log quiet for 5 min), then runs the env-gated live harness against the
# dev Fluss cluster and writes evidence.
set -u

REPO=/home/saurabh/Jupyter_notebook/Flink_Fluss_Infrastructure/streaming_project
SUITE="$REPO/logs/soak/full-suite-20260809-134456"
REC="$SUITE/soak/recoveries.txt"
RUNLOG="$SUITE/run.log"
OUT="$REPO/logs/safety-int-001"
mkdir -p "$OUT"
STAMP=$(date +%Y%m%d-%H%M%S)
EVIDENCE="$OUT/safety-int-001-$STAMP.out"

echo "[watcher] $(date -u +%FT%TZ) waiting for soak completion (i3 at ~12:06Z)..."

for i in $(seq 1 100); do
  n=$(grep -c '^recovery' "$REC" 2>/dev/null || echo 0)
  if [ "$n" -ge 3 ]; then
    # run.log quiet for >=300s?
    if [ -n "$(find "$RUNLOG" -mmin +5 2>/dev/null)" ]; then
      echo "[watcher] $(date -u +%FT%TZ) soak complete (recoveries=$n, run.log quiet)."
      break
    fi
  fi
  sleep 60
done

n=$(grep -c '^recovery' "$REC" 2>/dev/null || echo 0)
if [ "$n" -lt 3 ]; then
  echo "[watcher] $(date -u +%FT%TZ) TIMEOUT waiting for i3 recovery (recoveries=$n). Aborting T7 run." | tee "$EVIDENCE"
  exit 2
fi

echo "[watcher] $(date -u +%FT%TZ) grace sleep 120s before touching the cluster..."
sleep 120

echo "[watcher] $(date -u +%FT%TZ) running SAFETY-INT-001 against localhost:9123"
cd "$REPO/code" || exit 3
COMPUTE_INT_TEST_SAFETY=true FLUSS_BOOTSTRAP_SERVERS=localhost:9123 \
  mvn -f 02_services/02_compute/pom.xml test -Dtest=SafetyHaltLiveIntegrationTest \
  > "$EVIDENCE" 2>&1
rc=$?
echo "[watcher] $(date -u +%FT%TZ) SAFETY-INT-001 exit=$rc evidence=$EVIDENCE" | tee -a "$EVIDENCE"
exit $rc
