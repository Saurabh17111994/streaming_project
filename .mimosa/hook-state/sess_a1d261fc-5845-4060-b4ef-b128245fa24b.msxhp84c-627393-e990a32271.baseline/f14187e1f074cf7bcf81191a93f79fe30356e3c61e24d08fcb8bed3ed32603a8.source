import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.TablePath;

/** Drops the Stage 4 scratch tables (sig4_log_scratch / sig4_current_scratch). */
public class DropSignalScratchTables {
    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        String db = System.getenv().getOrDefault("FLUSS_DATABASE", "default");
        String logTable = System.getenv().getOrDefault("SCRATCH_LOG_TABLE", "sig4_log_scratch");
        String kvTable = System.getenv().getOrDefault("SCRATCH_KV_TABLE", "sig4_current_scratch");
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap);
        try (Connection conn = ConnectionFactory.createConnection(conf)) {
            conn.getAdmin().dropTable(TablePath.of(db, logTable), true).get();
            System.out.println("DROP_STATUS=OK table=" + db + "." + logTable);
            conn.getAdmin().dropTable(TablePath.of(db, kvTable), true).get();
            System.out.println("DROP_STATUS=OK table=" + db + "." + kvTable);
        }
    }
}
