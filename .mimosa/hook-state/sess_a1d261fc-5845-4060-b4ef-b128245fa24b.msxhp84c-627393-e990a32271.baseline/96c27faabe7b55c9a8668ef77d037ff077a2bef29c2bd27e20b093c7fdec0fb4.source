import java.util.List;
import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.Schema;
import org.apache.fluss.metadata.TableChange;
import org.apache.fluss.metadata.TableDescriptor;
import org.apache.fluss.metadata.TableInfo;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.types.DataTypes;

/**
 * Live TTL change 7d -> 2d (2026-08-13, user-approved destructive recreate).
 *
 * <p>Fluss 0.9.1 {@code table.log.ttl} is create-only (alter rejected — see
 * RetentionAlterProbe / logs/tracker-14/retention-l853-verification-20260813.md),
 * so applying the DDL blueprint (2d for the tables below) on the LIVE dev
 * cluster requires drop + recreate.
 *
 * <p>Sequence per table (FLUSS_TABLE env): BEFORE info -> if datalake enabled,
 * disable it (drop must not race the tiering; re-create WITHOUT datalake to
 * avoid the 0.9.1 create-only lake re-enable / R2 orphan collision) -> drop ->
 * sleep 20 s (async settle) -> create with 'table.log.ttl'='2d' -> AFTER info
 * (expect getLogTTLMs()==172_800_000).
 *
 * <p>Schemas cloned verbatim from the DDL blueprint. Batch 1 (2026-08-13):
 * raw_table_1 (20-col v2 LOG, 16 buckets, bucket.key instrument_token),
 * feature_candles_15s (15-col KV, PK (instrument_token, window_start),
 * bucket.key instrument_token, 16 buckets), ingestion_quarantine (10-col LOG,
 * 8 buckets, bucket.key quarantine_id). Batch 2 (same day): the 7 remaining
 * 2d-set tables — suspected_discontinuities (11-col LOG, 4 buckets,
 * discontinuity_id), Order_Lifecycle (15-col KV PK (account_scope_id,
 * broker_order_id), 8 buckets), Trade_Decisions (25-col LOG, 8 buckets,
 * instruction_id), Ranking_Results (19-col LOG, 8 buckets, evaluation_id),
 * Portfolio_Reservations (13-col KV PK reservation_id, 8 buckets),
 * Postback_Quarantine (13-col LOG, 8 buckets, quarantine_id),
 * Postback_Projection_Ledger (9-col KV PK postback_event_id, 8 buckets).
 */
public final class Recreate2d {

    static String bootstrap() {
        return System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "fluss-coordinator:9123");
    }

    static void info(Connection conn, String table, String tag) throws Exception {
        TableInfo t = conn.getAdmin().getTableInfo(TablePath.of("default", table)).get();
        System.out.println(tag + " table=" + table + " tableId=" + t.getTableId()
                + " kind=" + (t.hasPrimaryKey() ? "KV" : "LOG")
                + " pk=" + t.getPrimaryKeys()
                + " bucketKey=" + (t.hasBucketKey() ? t.getBucketKeys() : "<default>")
                + " buckets=" + t.getNumBuckets()
                + " ttlMs=" + t.getTableConfig().getLogTTLMs()
                + " lakeEnabled=" + t.getTableConfig().isDataLakeEnabled());
    }

    static TableDescriptor descriptor(String table) {
        Schema.Builder sb = Schema.newBuilder();
        TableDescriptor.Builder db = TableDescriptor.builder();
        switch (table) {
            case "raw_table_1" -> {
                sb.column("event_fingerprint", DataTypes.STRING())
                        .column("fingerprint_version", DataTypes.STRING())
                        .column("connection_id", DataTypes.STRING())
                        .column("connection_epoch", DataTypes.BIGINT())
                        .column("instrument_token", DataTypes.BIGINT())
                        .column("exchange", DataTypes.STRING())
                        .column("symbol", DataTypes.STRING())
                        .column("event_time", DataTypes.BIGINT())
                        .column("ingest_ts", DataTypes.BIGINT())
                        .column("ack_ts", DataTypes.BIGINT())
                        .column("tick_type", DataTypes.STRING())
                        .column("last_price_paise", DataTypes.BIGINT())
                        .column("last_qty", DataTypes.BIGINT())
                        .column("raw_payload", DataTypes.BYTES())
                        .column("payload_hash", DataTypes.STRING())
                        .column("decoder_version", DataTypes.STRING())
                        .column("protocol_version", DataTypes.STRING())
                        .column("validity_state", DataTypes.STRING())
                        .column("validity_reason", DataTypes.STRING())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(16, "instrument_token");
            }
            case "feature_candles_15s" -> {
                sb.column("instrument_token", DataTypes.BIGINT())
                        .column("exchange", DataTypes.STRING())
                        .column("symbol", DataTypes.STRING())
                        .column("window_start", DataTypes.BIGINT())
                        .column("window_end", DataTypes.BIGINT())
                        .column("open_paise", DataTypes.BIGINT())
                        .column("high_paise", DataTypes.BIGINT())
                        .column("low_paise", DataTypes.BIGINT())
                        .column("close_paise", DataTypes.BIGINT())
                        .column("volume", DataTypes.BIGINT())
                        .column("tick_count", DataTypes.INT())
                        .column("algorithm_version", DataTypes.STRING())
                        .column("configuration_version", DataTypes.STRING())
                        .column("output_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING())
                        .primaryKey("instrument_token", "window_start");
                db.schema(sb.build()).distributedBy(16, "instrument_token");
            }
            case "ingestion_quarantine" -> {
                sb.column("quarantine_id", DataTypes.STRING())
                        .column("reason", DataTypes.STRING())
                        .column("instrument_token", DataTypes.BIGINT())
                        .column("exchange", DataTypes.STRING())
                        .column("symbol", DataTypes.STRING())
                        .column("raw_payload", DataTypes.BYTES())
                        .column("payload_hash", DataTypes.STRING())
                        .column("detected_ts", DataTypes.BIGINT())
                        .column("detail", DataTypes.STRING())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(8, "quarantine_id");
            }
            case "suspected_discontinuities" -> {
                sb.column("discontinuity_id", DataTypes.STRING())
                        .column("source", DataTypes.STRING())
                        .column("reason", DataTypes.STRING())
                        .column("connection_epoch", DataTypes.BIGINT())
                        .column("last_tick_ts", DataTypes.BIGINT())
                        .column("last_tick_fingerprint", DataTypes.STRING())
                        .column("last_tick_token", DataTypes.BIGINT())
                        .column("last_tick_exchange", DataTypes.STRING())
                        .column("last_tick_symbol", DataTypes.STRING())
                        .column("detected_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(4, "discontinuity_id");
            }
            case "Order_Lifecycle" -> {
                sb.column("account_scope_id", DataTypes.STRING())
                        .column("broker_order_id", DataTypes.STRING())
                        .column("instruction_id", DataTypes.STRING())
                        .column("execution_attempt_id", DataTypes.STRING())
                        .column("trade_context_id", DataTypes.STRING())
                        .column("normalized_state", DataTypes.STRING())
                        .column("cumulative_qty", DataTypes.BIGINT())
                        .column("pending_qty", DataTypes.BIGINT())
                        .column("average_fill_price_paise", DataTypes.BIGINT())
                        .column("source_event_id", DataTypes.STRING())
                        .column("source_version", DataTypes.BIGINT())
                        .column("source_event_time", DataTypes.BIGINT())
                        .column("last_receive_time", DataTypes.BIGINT())
                        .column("correlation_state", DataTypes.STRING())
                        .column("schema_version", DataTypes.STRING())
                        .primaryKey("account_scope_id", "broker_order_id");
                db.schema(sb.build()).distributedBy(8, "account_scope_id", "broker_order_id");
            }
            case "Trade_Decisions" -> {
                sb.column("instruction_id", DataTypes.STRING())
                        .column("candidate_id", DataTypes.STRING())
                        .column("trade_context_id", DataTypes.STRING())
                        .column("instrument_token", DataTypes.BIGINT())
                        .column("exchange", DataTypes.STRING())
                        .column("symbol", DataTypes.STRING())
                        .column("side", DataTypes.STRING())
                        .column("quantity", DataTypes.BIGINT())
                        .column("order_type", DataTypes.STRING())
                        .column("product_type", DataTypes.STRING())
                        .column("limit_price_paise", DataTypes.BIGINT())
                        .column("portfolio_id", DataTypes.STRING())
                        .column("account_scope_id", DataTypes.STRING())
                        .column("strategy_id", DataTypes.STRING())
                        .column("strategy_version", DataTypes.STRING())
                        .column("configuration_version", DataTypes.STRING())
                        .column("evaluation_id", DataTypes.STRING())
                        .column("composite_score", DataTypes.DOUBLE())
                        .column("reservation_id", DataTypes.STRING())
                        .column("reservation_version", DataTypes.STRING())
                        .column("created_ts", DataTypes.BIGINT())
                        .column("expiry_ts", DataTypes.BIGINT())
                        .column("supersedes_instruction_id", DataTypes.STRING())
                        .column("superseded_by_instruction_id", DataTypes.STRING())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(8, "instruction_id");
            }
            case "Ranking_Results" -> {
                sb.column("evaluation_id", DataTypes.STRING())
                        .column("candidate_id", DataTypes.STRING())
                        .column("instruction_id", DataTypes.STRING())
                        .column("portfolio_id", DataTypes.STRING())
                        .column("model_id", DataTypes.STRING())
                        .column("configuration_version", DataTypes.STRING())
                        .column("normalized_scores", DataTypes.STRING())
                        .column("weight_id", DataTypes.STRING())
                        .column("composite_score", DataTypes.DOUBLE())
                        .column("rank", DataTypes.INT())
                        .column("selected", DataTypes.BOOLEAN())
                        .column("rejection_reason", DataTypes.STRING())
                        .column("reservation_snapshot", DataTypes.STRING())
                        .column("reservation_version", DataTypes.STRING())
                        .column("capacity_config_hash", DataTypes.STRING())
                        .column("evaluation_trigger", DataTypes.STRING())
                        .column("tie_break_data", DataTypes.STRING())
                        .column("evaluation_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(8, "evaluation_id");
            }
            case "Portfolio_Reservations" -> {
                sb.column("reservation_id", DataTypes.STRING())
                        .column("portfolio_id", DataTypes.STRING())
                        .column("account_scope_id", DataTypes.STRING())
                        .column("instruction_id", DataTypes.STRING())
                        .column("candidate_id", DataTypes.STRING())
                        .column("capacity_class", DataTypes.STRING())
                        .column("state", DataTypes.STRING())
                        .column("transition_version", DataTypes.BIGINT())
                        .column("source_evidence", DataTypes.STRING())
                        .column("expiry_ts", DataTypes.BIGINT())
                        .column("created_ts", DataTypes.BIGINT())
                        .column("updated_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING())
                        .primaryKey("reservation_id");
                db.schema(sb.build()).distributedBy(8, "reservation_id");
            }
            case "Postback_Quarantine" -> {
                sb.column("quarantine_id", DataTypes.STRING())
                        .column("postback_event_id", DataTypes.STRING())
                        .column("reason", DataTypes.STRING())
                        .column("original_payload", DataTypes.BYTES())
                        .column("payload_hash", DataTypes.STRING())
                        .column("broker_order_id", DataTypes.STRING())
                        .column("instruction_id", DataTypes.STRING())
                        .column("correlation_attempt", DataTypes.STRING())
                        .column("disposition", DataTypes.STRING())
                        .column("disposition_reason", DataTypes.STRING())
                        .column("quarantined_ts", DataTypes.BIGINT())
                        .column("disposition_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING());
                db.schema(sb.build()).distributedBy(8, "quarantine_id");
            }
            case "Postback_Projection_Ledger" -> {
                sb.column("postback_event_id", DataTypes.STRING())
                        .column("projection_state", DataTypes.STRING())
                        .column("expected_prior_state", DataTypes.STRING())
                        .column("retry_count", DataTypes.INT())
                        .column("last_error", DataTypes.STRING())
                        .column("disposition", DataTypes.STRING())
                        .column("step_ts", DataTypes.BIGINT())
                        .column("completed_ts", DataTypes.BIGINT())
                        .column("schema_version", DataTypes.STRING())
                        .primaryKey("postback_event_id");
                db.schema(sb.build()).distributedBy(8, "postback_event_id");
            }
            default -> throw new IllegalArgumentException("unknown table " + table);
        }
        return db.property("table.log.ttl", "2d").build();
    }

    public static void main(String[] args) throws Exception {
        String table = System.getenv("FLUSS_TABLE");
        if (table == null || table.isBlank()) {
            System.err.println("FLUSS_TABLE required (raw_table_1|feature_candles_15s|ingestion_quarantine"
                    + "|suspected_discontinuities|Order_Lifecycle|Trade_Decisions|Ranking_Results"
                    + "|Portfolio_Reservations|Postback_Quarantine|Postback_Projection_Ledger)");
            System.exit(2);
        }
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap());
        try (Connection conn = ConnectionFactory.createConnection(conf)) {
            TablePath path = TablePath.of("default", table);
            info(conn, table, "BEFORE");
            TableInfo before = conn.getAdmin().getTableInfo(path).get();
            if (before.getTableConfig().isDataLakeEnabled()) {
                conn.getAdmin().alterTable(path, List.of(
                        TableChange.set("table.datalake.enabled", "false")), false).get();
                System.out.println("LAKE_DISABLED table=" + table);
                info(conn, table, "LAKE_AFTER");
            } else {
                System.out.println("LAKE_NONE table=" + table);
            }
            conn.getAdmin().dropTable(path, true).get();
            System.out.println("DROP_STATUS=OK table=" + table);
            Thread.sleep(20_000L);
            conn.getAdmin().createTable(path, descriptor(table), true).get();
            System.out.println("CREATE_STATUS=OK table=" + table + " ttl=2d");
            info(conn, table, "AFTER");
            System.out.println("RECREATE2D_STATUS=OK table=" + table);
        }
    }
}
