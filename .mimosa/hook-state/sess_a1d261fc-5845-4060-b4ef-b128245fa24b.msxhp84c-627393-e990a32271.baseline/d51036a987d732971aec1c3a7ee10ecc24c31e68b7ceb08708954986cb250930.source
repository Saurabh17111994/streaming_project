import java.util.List;
import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.Schema;
import org.apache.fluss.metadata.TableChange;
import org.apache.fluss.metadata.TableDescriptor;
import org.apache.fluss.metadata.TableInfo;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.types.DataTypes;

/**
 * Demonstrates LIVE retention extension via the Admin alter API (foundation
 * L853 / version-matrix VM-FLUSS-SRV-005 retention boundary): create a
 * scratch LOG table at 7d TTL, alter the retention knob, and verify the
 * change through {@code getTableInfo} — the same API surface the EOD
 * retention-extension runbook (DEC-018, "extends while EOD unverified") would
 * use, on a scratch table so no pipeline table is touched.
 *
 * <p>Fluss 0.9.1 alter-whitelist fact (empirically probed 2026-08-13):
 * {@code table.log.ttl} is NOT alterable ("The option 'table.log.ttl' is not
 * supported to alter yet") but its server-side knob {@code log.retention.ms}
 * IS — the DDL-time option name and the alter-time option name differ, so
 * retention extension must go through {@code log.retention.ms}.</p>
 *
 * <p>Output contract: {@code TTL_BEFORE_MS=...} / {@code TTL_AFTER_MS=...}
 * plus the live table properties dump; exit 0 only when the alter took effect.</p>
 */
public class RetentionAlterProbe {
    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        String db = System.getenv().getOrDefault("FLUSS_DATABASE", "default");
        String table = System.getenv().getOrDefault("FLUSS_TABLE", "retention_demo");
        String ttlAfter = System.getenv().getOrDefault("TTL_AFTER", "14d");

        TablePath path = TablePath.of(db, table);
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap);

        try (Connection conn = ConnectionFactory.createConnection(conf)) {
            if (!conn.getAdmin().tableExists(path).get()) {
                Schema schema = Schema.newBuilder().column("k", DataTypes.BIGINT()).build();
                TableDescriptor desc = TableDescriptor.builder()
                        .schema(schema)
                        .distributedBy(1, "k")
                        .property("table.log.ttl", "7d")
                        .build();
                conn.getAdmin().createTable(path, desc, true).get();
                System.out.println("CREATE_STATUS=OK table=" + db + "." + table);
            } else {
                System.out.println("CREATE_STATUS=EXISTS table=" + db + "." + table);
            }

            TableInfo before = conn.getAdmin().getTableInfo(path).get();
            long ttlBeforeMs = before.getTableConfig().getLogTTLMs();
            System.out.println("TTL_BEFORE_MS=" + ttlBeforeMs);

            // 0.9.1: table.log.ttl rejects alters; log.retention.ms (server-side
            // knob) accepts them — verified via AlterWhitelistProbe 2026-08-13.
            conn.getAdmin()
                    .alterTable(path, List.of(TableChange.set("log.retention.ms", ttlAfter)), false)
                    .get();
            System.out.println("ALTER_STATUS=OK ttl=" + ttlAfter + " table=" + db + "." + table);

            TableInfo after = conn.getAdmin().getTableInfo(path).get();
            long ttlAfterMs = after.getTableConfig().getLogTTLMs();
            System.out.println("TTL_AFTER_MS=" + ttlAfterMs);
            System.out.println("TABLE_ID=" + after.getTableId());
            after.getProperties().toMap().forEach(
                    (k, v) -> System.out.println("PROP " + k + "=" + v));

            if (ttlAfterMs <= ttlBeforeMs) {
                System.err.println("ALTER_VERIFY=FAIL TTL did not extend: "
                        + ttlBeforeMs + " -> " + ttlAfterMs);
                System.exit(1);
            }
            System.out.println("ALTER_VERIFY=OK extended " + ttlBeforeMs + " -> " + ttlAfterMs);
        }
    }
}
