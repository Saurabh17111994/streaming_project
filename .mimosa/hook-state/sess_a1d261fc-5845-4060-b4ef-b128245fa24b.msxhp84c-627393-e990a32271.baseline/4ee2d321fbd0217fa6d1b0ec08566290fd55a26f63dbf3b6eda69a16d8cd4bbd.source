import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.client.table.Table;
import org.apache.fluss.client.table.writer.AppendWriter;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.row.BinaryString;
import org.apache.fluss.row.GenericRow;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.TimeUnit;

/**
 * Tracker-14 P6.2 live fault-injection feed harness (dev only).
 *
 * Modes:
 *   feed <nTokens> [durationSec]   append ticks with event_time=now to
 *                                  default.raw_table_1_p8 (resilient: retries
 *                                  failed batches so a paused/frozen Fluss
 *                                  tablet just queues appends)
 *   count <table> [buckets]        BatchScanner row count (sum over buckets)
 *
 * Compile: javac -cp ingestion.jar -d classes TickFeed.java
 * Run: java --add-opens=java.base/java.nio=ALL-UNNAMED -cp ingestion.jar:classes TickFeed feed 12 0
 */
public class TickFeed {

    // First 12 tokens of the real NSE_CM_EQUITY manifest (Token col).
    static final long[] TOKENS = {
        757614L, 759384L, 759438L, 759564L, 759576L, 760208L,
        760432L, 760584L, 760816L, 760952L, 760968L, 761208L
    };
    static final String[] SYMS = {
        "ARIS-EQ", "NIFTY", "BANKNIFTY", "RELIANCE", "TCS", "HDFCBANK",
        "INFY", "ICICIBANK", "SBIN", "AXISBANK", "KOTAKBANK", "LT"
    };

    public static void main(String[] args) throws Exception {
        if (args.length == 0) {
            System.err.println("usage: TickFeed feed <nTokens> [durationSec] | count <table> [bucketCount]");
            System.exit(2);
        }
        if (args[0].equals("count")) {
            count(args[1], args.length > 2 ? Integer.parseInt(args[2]) : 16);
            return;
        }
        int n = Integer.parseInt(args[1]);
        long durationSec = args.length > 2 ? Long.parseLong(args[2]) : 0;
        feed(n, durationSec);
    }

    static Connection connect() throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap);
        Connection c = ConnectionFactory.createConnection(conf);
        System.out.println("feed: connected to Fluss " + bootstrap);
        return c;
    }

    static void feed(int n, long durationSec) throws Exception {
        long[] tokens = new long[n];
        String[] syms = new String[n];
        for (int i = 0; i < n; i++) {
            tokens[i] = TOKENS[i % TOKENS.length] + (i / TOKENS.length) * 7919L;
            syms[i] = SYMS[i % SYMS.length] + (i / SYMS.length);
        }
        long deadline = durationSec > 0 ? System.currentTimeMillis() + durationSec * 1000L : Long.MAX_VALUE;
        long start = System.currentTimeMillis();
        try (Connection conn = connect()) {
            Table table = conn.getTable(TablePath.of("default",
                    System.getenv().getOrDefault("FLUSS_TABLE", "raw_table_1_p8")));
            AppendWriter writer = table.newAppend().createWriter();
            long total = 0, lastLog = System.currentTimeMillis();
            long base = 10_000L;
            while (System.currentTimeMillis() < deadline) {
                List<GenericRow> batch = new ArrayList<>();
                long now = System.currentTimeMillis();
                long tickNo = total;
                for (int i = 0; i < n; i++) {
                    long price = base + (tickNo * 7 + i * 13) % 401 - 200; // small walk
                    String fp = "faultfeed-" + tickNo + "-" + i;
                    batch.add(row(tokens[i], syms[i], now + i, fp, price));
                    tickNo++;
                }
                try {
                    for (GenericRow r : batch) {
                        writer.append(r).get(5, TimeUnit.SECONDS);
                    }
                    writer.flush();
                    total += n;
                } catch (Exception e) {
                    System.out.println("feed: batch failed (" + e.getClass().getSimpleName()
                            + ": " + truncate(e.getMessage(), 80) + ") — will retry");
                    try { Thread.sleep(2000); } catch (InterruptedException ie) { return; }
                    continue;
                }
                if (System.currentTimeMillis() - lastLog >= 5000) {
                    long elapsed = Math.max(1, System.currentTimeMillis() - start);
                    System.out.println("feed: appended=" + total + " rate=" + (total * 1000 / elapsed) + "/s");
                    lastLog = System.currentTimeMillis();
                }
                try { Thread.sleep(200); } catch (InterruptedException ie) { break; }
            }
            System.out.println("feed: done, total appended=" + total);
            try { writer.flush(); } catch (Exception ignore) { }
        }
    }

    static GenericRow row(long token, String sym, long eventTime, String fp, long price) {
        return GenericRow.of(
                bs(fp), bs("v2"), bs("faultfeed-conn"), 1L, token, bs("NSE"), bs(sym),
                eventTime, eventTime, eventTime, bs("TRADE"), price, 100L, new byte[0],
                bs("h-" + fp), bs("v2"), bs("1.0"), bs("VALID_TRADE"), null, bs("2"));
    }

    static void count(String tableName, int buckets) throws Exception {
        try (Connection conn = connect()) {
            Table table = conn.getTable(TablePath.of("default", tableName));
            long total = 0;
            org.apache.fluss.client.table.scanner.log.LogScanner scanner =
                    table.newScan().createLogScanner();
            for (int b = 0; b < buckets; b++) {
                scanner.subscribeFromBeginning(b);
                long bucketRows = 0;
                int emptyPolls = 0;
                while (emptyPolls < 3) {
                    org.apache.fluss.client.table.scanner.log.ScanRecords recs =
                            scanner.poll(java.time.Duration.ofMillis(500));
                    int c = recs.count();
                    if (c == 0) {
                        emptyPolls++;
                    } else {
                        bucketRows += c;
                        emptyPolls = 0;
                    }
                }
                scanner.unsubscribe(b);
                total += bucketRows;
            }
            System.out.println("count: " + tableName + " rows=" + total);
        }
    }

    static BinaryString bs(String s) {
        return s != null ? BinaryString.fromString(s) : BinaryString.EMPTY_UTF8;
    }

    static String truncate(String s, int n) {
        if (s == null) return "null";
        return s.length() <= n ? s : s.substring(0, n) + "...";
    }
}
