import java.util.List;
import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.Schema;
import org.apache.fluss.metadata.TableChange;
import org.apache.fluss.metadata.TableDescriptor;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.types.DataTypes;

/**
 * Empirical probe of which table options Fluss 0.9.1 allows through the Admin
 * alter API (the {@code table.log.ttl} alter path throws
 * {@code InvalidAlterTableException: The option '...' is not supported to alter yet}).
 * Tries a candidate whitelist one option at a time on a scratch LOG table and
 * prints ALTER_OK / ALTER_REJECTED per key — the fact base for foundation L853.
 */
public class AlterWhitelistProbe {
    private static final String[] CANDIDATES = {
        "table.log.ttl",
        "table.retention.ms",
        "log.retention.ms",
        "table.datalake.enabled",
        "table.datalake.format",
        "table.datalake.freshness",
        "table.datalake.tiering",
        "table.comment",
        "comment",
        "bucket.key",
    };

    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        String db = System.getenv().getOrDefault("FLUSS_DATABASE", "default");
        String table = System.getenv().getOrDefault("FLUSS_TABLE", "alter_whitelist_probe");
        TablePath path = TablePath.of(db, table);
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap);

        try (Connection conn = ConnectionFactory.createConnection(conf)) {
            if (!conn.getAdmin().tableExists(path).get()) {
                Schema schema = Schema.newBuilder().column("k", DataTypes.BIGINT()).build();
                TableDescriptor desc = TableDescriptor.builder()
                        .schema(schema)
                        .distributedBy(1, "k")
                        .property("table.log.ttl", "7d")
                        .build();
                conn.getAdmin().createTable(path, desc, true).get();
            }
            for (String key : CANDIDATES) {
                try {
                    conn.getAdmin()
                            .alterTable(path, List.of(TableChange.set(key, "9999d")), false)
                            .get();
                    System.out.println("ALTER_OK       " + key);
                } catch (Exception e) {
                    String msg = e.getCause() == null ? e.toString() : e.getCause().getMessage();
                    System.out.println("ALTER_REJECTED " + key + "  ->  "
                            + (msg == null ? e.getClass().getSimpleName() : msg));
                }
            }
        }
    }
}
