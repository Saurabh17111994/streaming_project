package com.trading.common.evidence;

/**
 * Evidence record format
 * (docs/08_implementation/01-foundation.md &rarr; "Evidence record format", orig L159).
 *
 * <p>One record per verified capability; supports audit and the release-gate review.
 */
public class EvidenceRecord {
    public String workItemId;
    public java.util.List<String> requirementIds;
    public String artifact;
    public String version;
    public String environment;
    public String workload;
    public String clock;
    public String result;
    public String owner;
    public String date;
    public String limitations;
}
