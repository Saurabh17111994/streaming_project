import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.client.table.Table;
import org.apache.fluss.client.table.scanner.log.LogScanner;
import org.apache.fluss.client.table.scanner.log.ScanRecords;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.TablePath;

import java.time.Duration;

/**
 * P10 corrected restore probe (supersedes RestoreStallProbe.java artifact):
 *
 * <p>The original CONTROL loop was time-boxed to 3000ms. On a log longer than ~600k records it
 * exits mid-drain, so "log end" was actually the scan position at the 3s cutoff. This probe:
 * (1) prints the count at the 3000ms mark (reproducing the old artifact on the same table),
 * (2) keeps draining until an empty poll or PROBE_CONTROL_MS cap, so the true log end is measured,
 * (3) TEST subscribes at PROBE_OFFSET (default = measured true end) and reports consumed records,
 *     proving that subscribing at a frozen tail returns 0 records = correct idle-tail, not a stall,
 *     and that subscribing slightly below the end consumes the remaining tail.
 */
public class RestoreStallProbe2 {
    public static void main(String[] args) throws Exception {
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123"));
        String tableName = System.getenv().getOrDefault("FLUSS_TABLE", "raw_table_1_bench");
        int bucket = Integer.parseInt(System.getenv().getOrDefault("PROBE_BUCKET", "4"));
        long controlMs = Long.parseLong(System.getenv().getOrDefault("PROBE_CONTROL_MS", "60000"));
        long tailOffset = Long.parseLong(System.getenv().getOrDefault("PROBE_OFFSET", "-1"));
        long tailBehind = Long.parseLong(System.getenv().getOrDefault("PROBE_BEHIND", "1000"));

        try (Connection conn = ConnectionFactory.createConnection(conf)) {
            Table table = conn.getTable(TablePath.of("default", tableName));

            // CONTROL: drain from offset 0, snapshot count at the 3s mark (old probe artifact)
            long n3s = -1, lastOff3s = -1;
            long n0 = 0, lastOff = -1;
            long t0 = System.currentTimeMillis();
            try (LogScanner s0 = table.newScan().createLogScanner()) {
                s0.subscribe(bucket, 0L);
                long elapsed = 0;
                boolean drained = false;
                while (elapsed < controlMs) {
                    ScanRecords recs = s0.poll(Duration.ofMillis(1000));
                    n0 += recs.count();
                    var it = recs.iterator();
                    while (it.hasNext()) {
                        lastOff = Math.max(lastOff, it.next().logOffset());
                    }
                    elapsed = System.currentTimeMillis() - t0;
                    if (n3s < 0 && elapsed >= 3000) {
                        n3s = n0;
                        lastOff3s = lastOff;
                    }
                    if (lastOff > 0 && recs.count() == 0) {
                        drained = true;
                        break;
                    }
                }
                System.out.println("CONTROL bucket=" + bucket
                        + " countAt3s=" + n3s + " lastOffsetAt3s=" + lastOff3s
                        + " drained=" + drained + " total=" + n0
                        + " lastOffset=" + lastOff + " elapsedMs=" + (System.currentTimeMillis() - t0));
            }

            long trueEnd = lastOff + 1; // offset just past the last record = log end
            if (tailOffset < 0) tailOffset = trueEnd;
            long subOffset = tailOffset - tailBehind;

            // TEST 1: subscribe at a genuine tail offset (behind the end) -> must consume the tail
            try (LogScanner s1 = table.newScan().createLogScanner()) {
                s1.subscribe(bucket, subOffset);
                long n1 = 0, lastOff1 = -1;
                long t1 = System.currentTimeMillis();
                while (System.currentTimeMillis() - t1 < 8000) {
                    ScanRecords recs = s1.poll(Duration.ofMillis(1000));
                    n1 += recs.count();
                    var it = recs.iterator();
                    while (it.hasNext()) {
                        lastOff1 = Math.max(lastOff1, it.next().logOffset());
                    }
                    if (n1 > 0 && lastOff1 >= trueEnd - 1) break; // consumed up to the end
                }
                System.out.println("TEST behindEnd bucket=" + bucket + " offset=" + subOffset
                        + " expectedTail=" + tailBehind + " records=" + n1
                        + " lastOffset=" + lastOff1 + " reachedEnd=" + (lastOff1 >= trueEnd - 1));
            }

            // TEST 2: subscribe exactly at the log end (frozen) -> 0 records = correct idle-tail
            try (LogScanner s2 = table.newScan().createLogScanner()) {
                s2.subscribe(bucket, trueEnd);
                long n2 = 0;
                long t2 = System.currentTimeMillis();
                while (System.currentTimeMillis() - t2 < 8000) {
                    ScanRecords recs = s2.poll(Duration.ofMillis(1000));
                    n2 += recs.count();
                }
                System.out.println("TEST atEnd bucket=" + bucket + " offset=" + trueEnd
                        + " records=" + n2 + " (0 = correct idle-tail at frozen end, NOT a stall)");
            }
        }
    }
}
