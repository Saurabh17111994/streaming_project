import java.net.URI;
import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.FileSystem;
import org.apache.hadoop.fs.LocatedFileStatus;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.fs.RemoteIterator;

/**
 * Lists top-level prefixes of the R2 bucket through the same S3A conf chain as
 * probe-r2.sh (endpoint/region/path-style from env; fs.s3a.impl pinned). Used to
 * locate checkpoint prefixes for the P10 rehearsal archive. Credentials are never
 * printed (they live in the hadoop conf, not in any path).
 */
public final class S3ListProbe {

    public static void main(String[] args) throws Exception {
        Configuration conf = new Configuration();
        String endpoint = System.getenv("S3_ENDPOINT");
        if (endpoint == null || endpoint.isEmpty()) {
            endpoint = System.getenv("R2_ENDPOINT");
        }
        conf.set("fs.s3a.endpoint", endpoint);
        conf.set("fs.s3a.endpoint.region", System.getenv("AWS_REGION"));
        conf.set("fs.s3a.path.style.access", "true");
        conf.set("fs.s3a.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem");
        conf.set("fs.s3.impl", "org.apache.hadoop.fs.s3a.S3AFileSystem");
        conf.set("fs.s3a.connection.timeout", "30000");
        conf.set("fs.s3a.connection.establish.timeout", "30000");
        conf.set("fs.s3a.access.key", System.getenv("AWS_ACCESS_KEY_ID"));
        conf.set("fs.s3a.secret.key", System.getenv("AWS_SECRET_ACCESS_KEY"));

        String base = args.length > 0 ? args[0] : "s3a://tradingticks-aug-2026/";
        FileSystem fs = FileSystem.get(URI.create(base), conf);
        int depth = args.length > 1 ? Integer.parseInt(args[1]) : 2;
        list(fs, new Path(base), depth, 0);
        System.out.println("LIST_PROBE=OK");
    }

    static void list(FileSystem fs, Path p, int maxDepth, int depth) throws Exception {
        if (depth > maxDepth) return;
        RemoteIterator<org.apache.hadoop.fs.FileStatus> it = fs.listStatusIterator(p);
        while (it.hasNext()) {
            org.apache.hadoop.fs.FileStatus st = it.next();
            String ind = "  ".repeat(depth);
            if (st.isDirectory()) {
                System.out.println(ind + "[D] " + st.getPath().toString());
                list(fs, st.getPath(), maxDepth, depth + 1);
            } else {
                System.out.println(ind + "[F] " + st.getPath().toString() + " (" + st.getLen() + ")");
            }
        }
    }
}
