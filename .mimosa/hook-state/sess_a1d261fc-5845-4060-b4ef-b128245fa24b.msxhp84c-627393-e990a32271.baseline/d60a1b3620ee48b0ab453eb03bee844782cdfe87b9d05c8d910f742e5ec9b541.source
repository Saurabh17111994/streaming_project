#!/usr/bin/env bash
# R2 bounded lake-read probe (plan Phase 5): same batch container/classpath/env as
# run-batch.sh, same supplier env vars, plus a 90-second outer limit. Verifies the
# effective fs.s3a.* timeouts reach the S3AFileSystem instance and that HEAD/GET of
# small objects completes within the limit. Exit: 0=PASS, 2=probe failure, 124=outer
# limit reached, other=docker/env failure.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ENV_FILE="$REPO/code/01_platform/01_docker/.env"
JAR="$REPO/code/02_services/02_compute/target/compute.jar"

# compile against the exact runtime jars (host javac; same classpath as the container)
javac -cp "$JAR:/tmp/fluss-lake-iceberg.jar:/tmp/fluss-fs-s3.jar:/tmp/plugin-hdfs/fluss-fs-hdfs-0.9.1-incubating.jar:/home/saurabh/.m2/repository/org/apache/hadoop/hadoop-mapreduce-client-core/2.8.5/hadoop-mapreduce-client-core-2.8.5.jar" \
  -d "$REPO/logs/tracker-14" "$REPO/logs/tracker-14/R2Probe.java"
echo "PROBE_COMPILE=OK"

AWS_VARS=()
for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION S3_WAREHOUSE_PATH; do
  if value="$(grep -E "^${name}=" "$ENV_FILE" | head -1 | cut -d= -f2-)"; then
    [ -n "$value" ] && AWS_VARS+=("--env" "${name}=${value}")
  fi
done

set +e
timeout --foreground 300s docker run --rm --network 01_docker_trading-net \
  -v "$REPO/logs/tracker-14:/probe" \
  -v /tmp/flinklib:/flinklib \
  -v /tmp/fluss-lake-iceberg.jar:/lake-iceberg.jar \
  -v /tmp/fluss-fs-s3.jar:/fs-s3.jar \
  -v /tmp/plugin-hdfs/fluss-fs-hdfs-0.9.1-incubating.jar:/fs-hdfs.jar \
  -v /home/saurabh/.m2/repository/org/apache/hadoop/hadoop-mapreduce-client-core/2.8.5/hadoop-mapreduce-client-core-2.8.5.jar:/mr-core.jar \
  -v "$JAR:/compute.jar" \
  "${AWS_VARS[@]}" \
  --env FLUSS_BOOTSTRAP=fluss-coordinator:9123 \
  --env CANDLE_TABLE=candle_scale_log \
  --env CANDLE_MIGRATION_S3_CONNECTION_TIMEOUT_MS="${CANDLE_MIGRATION_S3_CONNECTION_TIMEOUT_MS:-30000}" \
  --env CANDLE_MIGRATION_S3_SOCKET_TIMEOUT_MS="${CANDLE_MIGRATION_S3_SOCKET_TIMEOUT_MS:-30000}" \
  eclipse-temurin:17-jre sh -c 'cd /probe && java -Xmx2g --add-opens=java.base/java.nio=ALL-UNNAMED -cp "/probe:/flinklib/*:/lake-iceberg.jar:/fs-s3.jar:/fs-hdfs.jar:/mr-core.jar:/compute.jar" R2Probe' \
  | tee "$REPO/logs/tracker-14/probe-r2-$(date +%Y%m%d-%H%M%S).log"
STATUS=$?
set -e
echo "PROBE_EXIT=$STATUS"
if [ "$STATUS" -eq 124 ]; then
  echo "PROBE_OUTER_TIMEOUT=1 (90s limit exceeded)" >&2
fi
exit "$STATUS"
