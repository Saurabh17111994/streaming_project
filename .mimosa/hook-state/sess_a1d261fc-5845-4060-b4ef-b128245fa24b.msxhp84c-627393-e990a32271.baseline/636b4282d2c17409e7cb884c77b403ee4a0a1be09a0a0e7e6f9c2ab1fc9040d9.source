import org.apache.flink.api.common.RuntimeExecutionMode;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.configuration.ExecutionOptions;
import org.apache.flink.streaming.api.datastream.DataStream;
import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;
import org.apache.flink.table.data.RowData;
import org.apache.fluss.client.initializer.OffsetsInitializer;
import org.apache.fluss.flink.source.FlussSource;
import org.apache.fluss.flink.source.deserializer.RowDataDeserializationSchema;

/** Probe: does Flink 2.2 BATCH mode accept FlussSource (declared UNBOUNDED)? */
public final class Probe {
    public static void main(String[] args) throws Exception {
        Configuration flinkConfig = new Configuration();
        flinkConfig.set(ExecutionOptions.RUNTIME_MODE, RuntimeExecutionMode.BATCH);
        StreamExecutionEnvironment env =
                StreamExecutionEnvironment.getExecutionEnvironment(flinkConfig);
        env.setParallelism(1);
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        String table = System.getenv().getOrDefault("FLUSS_TABLE", "candle_scale_log");
        FlussSource<RowData> source = FlussSource.<RowData>builder()
                .setBootstrapServers(bootstrap)
                .setDatabase("default")
                .setTable(table)
                .setStartingOffsets(OffsetsInitializer.full())
                .setDeserializationSchema(new RowDataDeserializationSchema())
                .build();
        System.out.println("PROBE boundedness=" + source.getBoundedness());
        DataStream<RowData> rows = env.fromSource(source,
                org.apache.flink.api.common.eventtime.WatermarkStrategy.noWatermarks(),
                "probe-source");
        long count = 0;
        try (var it = rows.map(r -> 1L).executeAndCollect()) {
            while (it.hasNext()) {
                it.next();
                count++;
            }
        }
        System.out.println("PROBE rows=" + count);
    }
}
