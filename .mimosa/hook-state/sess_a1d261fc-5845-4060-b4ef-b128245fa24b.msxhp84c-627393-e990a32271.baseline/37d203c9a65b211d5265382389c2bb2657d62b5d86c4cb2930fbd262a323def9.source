import java.lang.reflect.Method;
import java.net.URI;
import java.util.LinkedHashMap;
import java.util.Map;

import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.flink.utils.DataLakeUtils;
import org.apache.fluss.lake.iceberg.conf.HadoopUtils;
import org.apache.hadoop.fs.FileSystem;
import org.apache.hadoop.fs.FSDataInputStream;
import org.apache.hadoop.fs.LocatedFileStatus;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.fs.RemoteIterator;

/**
 * Bounded R2 lake-read probe (plan 20260812-fix-r2-iceberg-lake-read-stall Phase 5).
 *
 * <p>Replicates the batch job's conf chain with the REAL classes: server table options
 * (live fluss client) + CandleMigrationBatchJob.lakeCatalogProperties() supplier (reflection)
 * -> FlinkCatalog's "table.datalake."-prefixed table options -> DataLakeUtils
 * (strip table.datalake.iceberg.) -> HadoopUtils (strip iceberg.hadoop.) -> hadoop conf
 * -> S3AFileSystem. Then HEAD version-hint, GET newest metadata json, bounded read of one
 * data object — all through that same S3A instance, so the effective fs.s3a.* timeouts
 * are proven on the real read path. 90-second outer limit is enforced by probe-run.sh.
 * Credentials are never printed (redaction guard below).
 */
public final class R2Probe {

    static void step(String name, Object detail) {
        System.out.println("PROBE_STEP " + name + "=" + detail);
    }

    static String redact(String k, String v) {
        String kl = k.toLowerCase();
        if (kl.contains("key") || kl.contains("secret")
                || kl.contains("token") || kl.contains("credential")) {
            return "<redacted>";
        }
        return v;
    }

    static void fail(String msg) {
        throw new IllegalStateException(msg);
    }

    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "fluss-coordinator:9123");
        String table = System.getenv().getOrDefault("CANDLE_TABLE", "candle_scale_log");

        // 1. Server table options (same source the FlinkCatalog lake path uses).
        Map<String, String> serverProps;
        Configuration clientConf = new Configuration();
        clientConf.setString("bootstrap.servers", bootstrap);
        try (Connection connection = ConnectionFactory.createConnection(clientConf)) {
            TablePath path = TablePath.of("default", table);
            serverProps = new LinkedHashMap<>(
                    connection.getAdmin().getTableInfo(path).get().getProperties().toMap());
        }
        step("server-table-option-count", serverProps.size());

        // 2. Supplier keys via the real job helper (same env validation as the batch job).
        Method m = Class.forName("com.trading.compute.tools.CandleMigrationBatchJob")
                .getDeclaredMethod("lakeCatalogProperties");
        m.setAccessible(true);
        @SuppressWarnings("unchecked")
        Map<String, String> supplier = (Map<String, String>) m.invoke(null);
        step("supplier-keys", supplier.keySet());

        // 3. Table options exactly as FlinkCatalog.getTable builds them (table.datalake. prefix).
        Map<String, String> options = new LinkedHashMap<>(serverProps);
        for (Map.Entry<String, String> e : supplier.entrySet()) {
            options.put("table.datalake." + e.getKey(), e.getValue());
        }

        // 4. DataLakeUtils strips table.datalake.iceberg.
        Map<String, String> catalogProps =
                DataLakeUtils.extractLakeCatalogProperties(Configuration.fromMap(options));
        step("catalog-option-count", catalogProps.size());
        for (Map.Entry<String, String> e : catalogProps.entrySet()) {
            System.out.println("PROBE_OPT " + e.getKey() + "=" + redact(e.getKey(), e.getValue()));
        }

        // 5. HadoopUtils strips iceberg.hadoop. -> hadoop conf (fs.s3a.* keys).
        //    hadoop-aws 3.3.x: fs.s3a.connection.timeout -> SDK socket READ
        //    timeout; fs.s3a.connection.establish.timeout -> TCP connect
        //    timeout; fs.s3a.socket.timeout is NOT read (dead key).
        org.apache.hadoop.conf.Configuration hadoopConf =
                HadoopUtils.getHadoopConfiguration(Configuration.fromMap(catalogProps));
        String connT = hadoopConf.get("fs.s3a.connection.timeout", "<unset>");
        String estabT = hadoopConf.get("fs.s3a.connection.establish.timeout", "<unset>");
        String sockT = hadoopConf.get("fs.s3a.socket.timeout", "<unset>");
        step("hadoop-conf-connection-timeout", connT);
        step("hadoop-conf-establish-timeout", estabT);
        step("hadoop-conf-socket-timeout-dead-key", sockT);
        if (connT.equals("<unset>") || estabT.equals("<unset>")) {
            fail("timeout keys missing from hadoop conf");
        }

        // 6. Warehouse URI: catalog props first (per-table), env fallback.
        String warehouse = System.getenv("S3_WAREHOUSE_PATH");
        for (Map.Entry<String, String> e : catalogProps.entrySet()) {
            if (warehouse == null && e.getKey().toLowerCase().contains("warehouse")) {
                warehouse = e.getValue();
            }
        }
        if (warehouse == null) {
            fail("no warehouse option found in catalog props");
        }
        step("warehouse", warehouse);

        // 7. Real S3AFileSystem: effective timeouts on the instance used for the reads.
        FileSystem fs = FileSystem.get(URI.create(warehouse), hadoopConf);
        step("fs-scheme", fs.getScheme());
        step("fs-class", fs.getClass().getName());
        String instConn = fs.getConf().get("fs.s3a.connection.timeout", "0");
        String instEstab = fs.getConf().get("fs.s3a.connection.establish.timeout", "0");
        String instSock = fs.getConf().get("fs.s3a.socket.timeout", "0");
        step("instance-connection-timeout", instConn);
        step("instance-establish-timeout", instEstab);
        step("instance-socket-timeout-dead-key", instSock);
        long conn = Long.parseLong(instConn);
        long estab = Long.parseLong(instEstab);
        if (conn <= 0 || estab <= 0) {
            fail("effective S3A timeouts not nonzero on instance (conn=" + instConn
                    + ", estab=" + instEstab + ")");
        }

        // 8-10. One recursive walk: HEAD the metadata dir + newest metadata json,
        // GET the json fully, then bounded-read one data object. (The fluss lake
        // writes *.metadata.json but no version-hint.txt — the stalled
        // HadoopTableOperations path falls back to the metadata listing, so the
        // json itself is the HEAD target.)
        LocatedFileStatus newestMeta = null;
        LocatedFileStatus dataFile = null;
        RemoteIterator<LocatedFileStatus> walk = fs.listFiles(new Path(warehouse), true);
        while (walk.hasNext()) {
            LocatedFileStatus st = walk.next();
            String name = st.getPath().getName();
            if (name.endsWith(".metadata.json")) {
                if (newestMeta == null || st.getModificationTime() > newestMeta.getModificationTime()) {
                    newestMeta = st;
                }
            } else if (dataFile == null && name.endsWith(".parquet")) {
                dataFile = st;
            }
        }
        if (newestMeta == null) {
            fail("no *.metadata.json found under " + warehouse);
        }
        Path metadataDir = newestMeta.getPath().getParent();
        step("head-metadata-dir", metadataDir.toString() + " entries="
                + fs.listStatus(metadataDir).length);
        step("head-metadata-json", newestMeta.getPath().getName() + " size=" + newestMeta.getLen());
        byte[] metaBytes;
        try (FSDataInputStream in = fs.open(newestMeta.getPath())) {
            metaBytes = in.readAllBytes();
        }
        step("get-metadata-json", newestMeta.getPath().getName() + " bytes=" + metaBytes.length);
        // 10. EXACT wedge path: read a parquet footer through the Iceberg FileIO
        // (org.apache.iceberg.io.FileIO from the catalog the fluss plugin builds —
        // IcebergCatalogUtils.createIcebergCatalog, the same call IcebergCatalogProvider
        // makes) and print THAT S3A instance's effective timeouts. The audit wedge
        // (2026-08-12) is S3AInputStream.reopen -> getObject -> Net.poll in
        // ParquetFileReader.readFooter via IcebergRecordReader.
        Map<String, String> catalogPropsForCatalog = new LinkedHashMap<>(catalogProps);
        catalogPropsForCatalog.putIfAbsent("type", "hadoop");
        org.apache.iceberg.catalog.Catalog icebergCatalog =
                org.apache.fluss.lake.iceberg.utils.IcebergCatalogUtils.createIcebergCatalog(
                        Configuration.fromMap(catalogPropsForCatalog));
        org.apache.iceberg.Table icebergTable = icebergCatalog.loadTable(
                org.apache.iceberg.catalog.TableIdentifier.of("default", table));
        org.apache.iceberg.Snapshot snap = icebergTable.currentSnapshot();
        step("iceberg-snapshot", snap == null ? "<null>" : Long.toString(snap.snapshotId()));
        org.apache.iceberg.io.FileIO tableIo = icebergTable.io();
        step("fileio-class", tableIo.getClass().getName());
        if (tableIo instanceof org.apache.iceberg.hadoop.HadoopFileIO) {
            java.lang.reflect.Field f = null;
            for (java.lang.reflect.Field cand :
                    org.apache.iceberg.hadoop.HadoopFileIO.class.getDeclaredFields()) {
                cand.setAccessible(true);
                if (cand.get(tableIo) instanceof org.apache.hadoop.conf.Configuration) {
                    f = cand;
                    break;
                }
            }
            if (f != null) {
                org.apache.hadoop.conf.Configuration ioConf =
                        (org.apache.hadoop.conf.Configuration) f.get(tableIo);
                step("fileio-conf-connection-timeout",
                        ioConf.get("fs.s3a.connection.timeout", "<unset>"));
                step("fileio-conf-socket-timeout",
                        ioConf.get("fs.s3a.socket.timeout", "<unset>"));
            } else {
                step("fileio-conf", "<no Configuration field found>");
            }
        }
        if (dataFile == null) {
            fail("no .parquet found under " + warehouse);
        }
        long t0 = System.currentTimeMillis();
        int footerMagic;
        try (org.apache.iceberg.io.SeekableInputStream in = tableIo.newInputFile(
                dataFile.getPath().toString()).newStream()) {
            in.seek(dataFile.getLen() - 4);
            byte[] magic = new byte[4];
            int off = 0;
            while (off < 4) {
                int r = in.read(magic, off, 4 - off);
                if (r < 0) {
                    break;
                }
                off += r;
            }
            footerMagic = ((magic[0] & 0xFF) << 24) | ((magic[1] & 0xFF) << 16)
                    | ((magic[2] & 0xFF) << 8) | (magic[3] & 0xFF);
        }
        long t1 = System.currentTimeMillis();
        step("read-parquet-footer", dataFile.getPath().getName() + " magic=0x"
                + Integer.toHexString(footerMagic) + " ms=" + (t1 - t0));
        // 11. EXACT audit reader chain: the FileScanTask's file.io() (NOT table.io() —
        // GenericReader.open reads via task.file().io()) + IcebergGenericReader.open.
        step("s3a-origin", org.apache.hadoop.fs.s3a.S3AFileSystem.class.getProtectionDomain()
                .getCodeSource().getLocation().toString());
        step("hadoop-version", org.apache.hadoop.util.VersionInfo.getVersion());
        step("const-socket-timeout", org.apache.hadoop.fs.s3a.Constants.SOCKET_TIMEOUT);
        step("const-connection-timeout", "fs.s3a.connection.timeout");
        java.util.List<org.apache.iceberg.FileScanTask> tasks = new java.util.ArrayList<>();
        icebergTable.newScan().planFiles().forEach(tasks::add);
        step("task-count", Integer.toString(tasks.size()));
        long t2 = System.currentTimeMillis();
        org.apache.iceberg.data.IcebergGenericReader greader =
                new org.apache.iceberg.data.IcebergGenericReader(icebergTable.newScan(), true);
        int rows = 0;
        try (org.apache.iceberg.io.CloseableIterable<org.apache.iceberg.data.Record> recs =
                greader.open(tasks.get(0))) {
            for (org.apache.iceberg.data.Record r : recs) {
                if (++rows >= 3) {
                    break;
                }
            }
        }
        long t3 = System.currentTimeMillis();
        step("generic-reader-open", "rows=" + rows + " ms=" + (t3 - t2) + " file="
                + tasks.get(0).file().path().toString());
        // 12. Serialization round-trip — the audit serializes the lake source
        // (fluss Configuration via default Java serialization; hadoop Configuration
        // via HadoopConfSerde Writable write/readFields) into the Flink job graph;
        // the probe never serializes. If a round-trip drops the fs.s3a.* pins, the
        // audit's runtime conf lacks them and the S3A socket timeout falls back.
        byte[] rtFluss;
        try (java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
             java.io.ObjectOutputStream oos = new java.io.ObjectOutputStream(bos)) {
            oos.writeObject(Configuration.fromMap(catalogProps));
            rtFluss = bos.toByteArray();
        }
        org.apache.fluss.config.Configuration deserFluss;
        try (java.io.ObjectInputStream ois = new java.io.ObjectInputStream(
                new java.io.ByteArrayInputStream(rtFluss))) {
            deserFluss = (org.apache.fluss.config.Configuration) ois.readObject();
        }
        step("rt-fluss-connection-timeout",
                deserFluss.toMap().get("iceberg.iceberg.hadoop.fs.s3a.connection.timeout"));
        step("rt-fluss-socket-timeout",
                deserFluss.toMap().get("iceberg.iceberg.hadoop.fs.s3a.socket.timeout"));
        step("rt-fluss-keys", deserFluss.toMap().keySet().toString());
        step("rt-fluss-count", Integer.toString(deserFluss.toMap().size()));
        java.io.ByteArrayOutputStream rtHadoopBos = new java.io.ByteArrayOutputStream();
        try (java.io.DataOutputStream dos = new java.io.DataOutputStream(rtHadoopBos)) {
            hadoopConf.write(dos);
        }
        org.apache.hadoop.conf.Configuration rtHadoop = new org.apache.hadoop.conf.Configuration();
        rtHadoop.readFields(new java.io.DataInputStream(
                new java.io.ByteArrayInputStream(rtHadoopBos.toByteArray())));
        step("rt-hadoop-connection-timeout", rtHadoop.get("fs.s3a.connection.timeout", "<unset>"));
        step("rt-hadoop-establish-timeout",
                rtHadoop.get("fs.s3a.connection.establish.timeout", "<unset>"));
        // 13. Read back what the REAL S3AUtils builds: ClientConfiguration from the
        // pinned conf — the audit wedge implies socketTimeout=0 (no 200s default
        // ever fired across three stalls); the conf says 30000. See what the
        // deployed S3AUtils actually produces.
        try {
            java.lang.reflect.Method initConn = org.apache.hadoop.fs.s3a.S3AUtils.class
                    .getDeclaredMethod("initConnectionSettings",
                            org.apache.hadoop.conf.Configuration.class,
                            com.amazonaws.ClientConfiguration.class);
            initConn.setAccessible(true);
            com.amazonaws.ClientConfiguration cc = new com.amazonaws.ClientConfiguration();
            initConn.invoke(null, hadoopConf, cc);
            step("s3a-client-socket-timeout", Integer.toString(cc.getSocketTimeout()));
            step("s3a-client-connection-timeout", Integer.toString(cc.getConnectionTimeout()));
            step("s3a-client-max-connections", Integer.toString(cc.getMaxConnections()));
        } catch (Throwable t) {
            step("s3a-client-config", "failed " + t.getClass().getSimpleName() + ": " + t.getMessage());
        }
        // Rebuild the S3A from the round-tripped conf and issue the EXACT wedge
        // call: HadoopTableOperations.getMetadataFile -> S3AFileSystem.getObjectMetadata.
        org.apache.hadoop.fs.FileSystem rtFs =
                org.apache.hadoop.fs.FileSystem.get(URI.create(warehouse), rtHadoop);
        long t4 = System.currentTimeMillis();
        org.apache.hadoop.fs.FileStatus rtStatus = rtFs.getFileStatus(newestMeta.getPath());
        step("rt-head-metadata-json", rtStatus.getPath().getName() + " size=" + rtStatus.getLen()
                + " ms=" + (System.currentTimeMillis() - t4));
        // 15. IDLE-REUSE reproduction of the audit wedge: the audit's source task
        // reuses a pooled connection the split planner opened (idle ~60-90 s,
        // long enough for the R2/Cloudflare edge to drop it without RST). If the
        // pool hands out that half-open socket, the request is sent and the read
        // hangs with NO socket timeout (the SDK's SO_TIMEOUT is applied at socket
        // CREATION via SocketConfig; a reused socket keeps its original value —
        // and a half-open socket never fires a read timeout in the kernel poll).
        // Probe the behavior: warmup is already done above (step 14); idle 75 s;
        // re-issue the identical HEAD. A hang here reproduces the audit wedge.
        long t5 = System.currentTimeMillis();
        System.out.println("PROBE_STEP idle-reuse-before-sleep-ms="
                + (System.currentTimeMillis() - t5) + " now-sleeping-75s");
        Thread.sleep(75_000);
        long t6 = System.currentTimeMillis();
        org.apache.hadoop.fs.FileStatus idleStatus = rtFs.getFileStatus(newestMeta.getPath());
        step("idle-reuse-reread-ms", idleStatus.getPath().getName() + " size="
                + idleStatus.getLen() + " ms=" + (System.currentTimeMillis() - t6));

        System.out.println("PROBE_RESULT=PASS");
    }
}
