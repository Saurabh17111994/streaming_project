import java.time.Duration;
import org.apache.fluss.client.Connection;
import org.apache.fluss.client.ConnectionFactory;
import org.apache.fluss.client.table.Table;
import org.apache.fluss.client.table.scanner.batch.BatchScanner;
import org.apache.fluss.config.Configuration;
import org.apache.fluss.metadata.TableBucket;
import org.apache.fluss.metadata.TableInfo;
import org.apache.fluss.metadata.TablePath;
import org.apache.fluss.row.InternalRow;
import org.apache.fluss.utils.CloseableIterator;

/**
 * E2E evidence: read back ingestion_quarantine rows. Schema (v1):
 * 0 quarantine_id STRING, 1 reason STRING, 2 instrument_token BIGINT,
 * 3 exchange STRING, 4 symbol STRING, 5 raw_payload BYTES,
 * 6 payload_hash STRING, 7 detected_ts BIGINT, 8 detail STRING,
 * 9 schema_version STRING. Env: FLUSS_BOOTSTRAP, FLUSS_TABLE.
 */
public final class QuarantineScan {
    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "localhost:9123");
        String tableName = System.getenv().getOrDefault("FLUSS_TABLE", "ingestion_quarantine");
        Configuration conf = new Configuration();
        conf.setString("bootstrap.servers", bootstrap);
        long total = 0;
        try (Connection connection = ConnectionFactory.createConnection(conf)) {
            TableInfo info = connection.getAdmin()
                    .getTableInfo(TablePath.of("default", tableName)).join();
            Table table = connection.getTable(TablePath.of("default", tableName));
            for (int b = 0; b < info.getNumBuckets(); b++) {
                TableBucket tb = new TableBucket(info.getTableId(), b);
                long perBucket = 0;
                try (BatchScanner scanner =
                             table.newScan().limit(1_000_000_000).createBatchScanner(tb);
                     CloseableIterator<InternalRow> it =
                             scanner.pollBatch(Duration.ofMillis(30_000))) {
                    while (it.hasNext()) {
                        InternalRow row = it.next();
                        perBucket++;
                        String qid = s(row, 0);
                        String reason = s(row, 1);
                        long token = row.isNullAt(2) ? -1 : row.getLong(2);
                        String detail = s(row, 8);
                        System.out.println("BUCKET_" + b + " id=" + qid
                                + " reason=" + reason + " token=" + token
                                + " detail=" + (detail == null ? "<null>" : detail));
                    }
                }
                System.out.println("QUARANTINE_BUCKET_" + b + "=" + perBucket);
                total += perBucket;
            }
            System.out.println("QUARANTINE_TOTAL=" + total);
        }
    }

    private static String s(InternalRow row, int idx) {
        if (row.isNullAt(idx)) return null;
        try {
            return row.getString(idx).toString();
        } catch (Exception e) {
            return "<non-string>";
        }
    }
}
