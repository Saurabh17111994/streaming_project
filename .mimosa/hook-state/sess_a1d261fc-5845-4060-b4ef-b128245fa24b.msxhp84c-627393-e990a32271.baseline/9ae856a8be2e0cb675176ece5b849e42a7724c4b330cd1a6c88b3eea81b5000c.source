import java.util.Map;
import org.apache.flink.api.common.RuntimeExecutionMode;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.configuration.ExecutionOptions;
import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;
import org.apache.flink.table.api.bridge.java.StreamTableEnvironment;
import org.apache.fluss.flink.catalog.FlinkCatalog;

/**
 * Scratch: create a Paimon-lake probe table (table.datalake.format=paimon)
 * on the dev cluster to verify tiering to the Paimon warehouse on R2.
 */
public final class PaimonProbe {
    public static void main(String[] args) throws Exception {
        String bootstrap = System.getenv().getOrDefault("FLUSS_BOOTSTRAP", "fluss-coordinator:9123");
        Configuration flinkConf = new Configuration();
        flinkConf.set(ExecutionOptions.RUNTIME_MODE, RuntimeExecutionMode.BATCH);
        StreamExecutionEnvironment env =
                StreamExecutionEnvironment.getExecutionEnvironment(flinkConf);
        env.setParallelism(1);
        StreamTableEnvironment tEnv = StreamTableEnvironment.create(env);
        tEnv.registerCatalog("fluss", new FlinkCatalog(
                "fluss", "default", bootstrap, PaimonProbe.class.getClassLoader(),
                Map.of(), Map::of));
        tEnv.useCatalog("fluss");
        tEnv.useDatabase("default");
        String ddl = "CREATE TABLE IF NOT EXISTS `paimon_probe` ("
                + "instrument_token BIGINT NOT NULL, exchange STRING NOT NULL, symbol STRING NOT NULL, "
                + "window_start BIGINT NOT NULL, window_end BIGINT NOT NULL, open_paise BIGINT NOT NULL, "
                + "high_paise BIGINT NOT NULL, low_paise BIGINT NOT NULL, close_paise BIGINT NOT NULL, "
                + "volume BIGINT NOT NULL, tick_count INT NOT NULL, algorithm_version STRING NOT NULL, "
                + "configuration_version STRING NOT NULL, output_ts BIGINT NOT NULL, schema_version STRING NOT NULL"
                + ") WITH ("
                + " 'connector' = 'fluss',"
                + " 'bootstrap.servers' = '" + bootstrap + "',"
                + " 'table.datalake.enabled' = 'true',"
                + " 'table.datalake.format' = 'paimon')";
        try {
            tEnv.executeSql(ddl);
            System.out.println("PAIMON_DDL_OK");
        } catch (Throwable t) {
            System.out.println("PAIMON_DDL_FAIL " + t.getClass().getName() + ": " + t.getMessage());
            t.printStackTrace(System.out);
        }
    }
}
