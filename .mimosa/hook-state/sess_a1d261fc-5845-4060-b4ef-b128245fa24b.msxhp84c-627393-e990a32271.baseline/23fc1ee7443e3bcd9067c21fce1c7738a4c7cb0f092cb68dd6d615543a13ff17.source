#!/usr/bin/env bash
# Tracker 14 P3.3 (box 419): run CandleMigrationBatchJob (audit|load) against the
# lake-enabled dev candle_scale_log from inside the docker network. The dev lake
# warehouse is R2 (s3://tradingticks-aug-2026/lake/), so the client classpath
# carries the fluss lake/iceberg + s3 plugins (copied from the coordinator) and
# the R2 credentials arrive via env injection (never logged).
# Usage: logs/tracker-14/run-batch.sh audit|load
#
# S3A bounded-timeout containment (plan 20260812-fix-r2-iceberg-lake-read-stall):
#   CANDLE_MIGRATION_S3_CONNECTION_TIMEOUT_MS / _SOCKET_TIMEOUT_MS (default 30000,
#   range [1000, 300000]) -> the job's lake-catalog supplier -> fs.s3a.* conf.
#   CANDLE_MIGRATION_MAX_RUNTIME (default 90m) -> outer deadline: exit status 124
#   + CANDLE_MIGRATION_OUTER_TIMEOUT=1 when the deadline is reached (last-resort
#   containment; the S3A timeouts are the primary fix).
set -euo pipefail
MODE="${1:-audit}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ENV_FILE="$REPO/code/01_platform/01_docker/.env"
CTR="candle-mig-${MODE}-$$"

# The outer deadline kills only the docker CLI (timeout --foreground does not
# forward SIGTERM to the container), so the JVM would keep running orphaned
# past the deadline. Name the container and remove it on any exit — normal
# exits are a no-op because --rm already removed it.
cleanup() {
  if docker ps -a --format '{{.Names}}' | grep -qx "$CTR"; then
    docker rm -f "$CTR" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

JAR="$REPO/code/02_services/02_compute/target/compute.jar"
LOG="$REPO/logs/tracker-14/batch-$MODE-$(date +%Y%m%d-%H%M%S).log"

# env-inject R2 creds: read names+values from .env, pass through docker -e
# (values never appear on the command line of this host shell).
AWS_VARS=()
for name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION; do
  if value="$(grep -E "^${name}=" "$ENV_FILE" | head -1 | cut -d= -f2-)"; then
    [ -n "$value" ] && AWS_VARS+=("--env" "${name}=${value}")
  fi
done

set +e
timeout --foreground -k 10s "${CANDLE_MIGRATION_MAX_RUNTIME:-90m}" docker run --rm --name "$CTR" --network 01_docker_trading-net \
  -v "$REPO/logs/tracker-14:/probe" \
  -v /tmp/flinklib:/flinklib \
  -v /tmp/fluss-lake-iceberg.jar:/lake-iceberg.jar \
  -v /tmp/fluss-fs-s3.jar:/fs-s3.jar \
  -v /tmp/plugin-hdfs/fluss-fs-hdfs-0.9.1-incubating.jar:/fs-hdfs.jar \
  -v /home/saurabh/.m2/repository/org/apache/hadoop/hadoop-mapreduce-client-core/2.8.5/hadoop-mapreduce-client-core-2.8.5.jar:/mr-core.jar \
  -v "$JAR:/compute.jar" \
  "${AWS_VARS[@]}" \
  --env FLUSS_BOOTSTRAP_SERVERS=fluss-coordinator:9123 \
  --env CANDLE_TABLE=candle_scale_log \
  --env CANDLE_CURRENT_TABLE=candle_scale_kv \
  --env SCHEMA_VERSION=2 \
  --env CANDLE_MIGRATION_MODE="$MODE" \
  --env CANDLE_MIGRATION_REPORT_DIR=/probe \
  --env CANDLE_MIGRATION_S3_CONNECTION_TIMEOUT_MS="${CANDLE_MIGRATION_S3_CONNECTION_TIMEOUT_MS:-30000}" \
  --env CANDLE_MIGRATION_S3_SOCKET_TIMEOUT_MS="${CANDLE_MIGRATION_S3_SOCKET_TIMEOUT_MS:-30000}" \
  --env CANDLE_MIGRATION_PARALLELISM="${CANDLE_MIGRATION_PARALLELISM:-16}" \
  eclipse-temurin:17-jre sh -c 'cd /probe && java -Xmx3g --add-opens=java.base/java.nio=ALL-UNNAMED -XX:+UnlockDiagnosticVMOptions -XX:NativeMemoryTracking=summary -XX:+PrintNMTStatistics -cp "/probe:/flinklib/*:/lake-iceberg.jar:/fs-s3.jar:/fs-hdfs.jar:/mr-core.jar:/compute.jar" com.trading.compute.tools.CandleMigrationBatchJob' \
  | tee "$LOG"
BATCH_STATUS=$?
set -e
echo "BATCH_LOG=$LOG"
if [ "$BATCH_STATUS" -eq 124 ] || [ "$BATCH_STATUS" -eq 137 ]; then
  echo "CANDLE_MIGRATION_OUTER_TIMEOUT=1 (outer deadline ${CANDLE_MIGRATION_MAX_RUNTIME:-90m} exceeded; see $LOG)" >&2
fi
exit "$BATCH_STATUS"
